---
const { color, label, role } = Astro.props;
---

<div class="flex flex-col gap-4 p-6 bg-brand-surface border border-brand-accent/20 rounded-2xl transition-all hover:border-brand-accent/40 group">
  <div 
    class="w-full h-32 rounded-xl shadow-inner transition-transform group-hover:scale-[1.02]" 
    style={`background-color: ${color}`}
  ></div>
  <div class="flex flex-col gap-1">
    <span class="font-brand-display font-black uppercase text-xl tracking-tight leading-none text-brand-text-high">{label}</span>
    <span class="text-sm text-brand-text-muted leading-relaxed">{role}</span>
    <code class="text-xs mt-3 px-3 py-1 bg-brand-accent/10 border border-brand-accent/10 text-brand-accent rounded-full self-start font-mono font-bold tracking-wider">
      {color}
    </code>
  </div>
</div>
