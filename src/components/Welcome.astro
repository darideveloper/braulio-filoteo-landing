---
import BrandButton from './BrandButton.astro';
import ColorSwatch from './ColorSwatch.astro';

const colors = [
  { label: 'Main Background', color: '#000000', role: 'Creates high contrast and depth.' },
  { label: 'Headings', color: '#9b30ff', role: "Mirrors the brand's bold typography." },
  { label: 'Primary Buttons', color: '#ff0099', role: 'High visibility for conversions.' },
  { label: 'Body Text', color: '#D9D9D9', role: 'Soft white/gray for readability against black.' },
];
---

<div class="container py-16 space-y-12">
  <section class="space-y-4 text-center max-w-3xl mx-auto">
    <h1 class="text-7xl font-black uppercase tracking-tight">Braulio Filoteo</h1>
    <p class="text-2xl text-brand-text opacity-90">
      Brand identity and style system integration using Tailwind v4.
    </p>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {colors.map((c) => (
      <ColorSwatch {...c} />
    ))}
  </section>

  <section class="flex flex-col items-center gap-8 py-12 bg-brand-text/5 rounded-2xl">
    <h2 class="text-4xl font-bold">Call to Action</h2>
    <BrandButton>Get Started Now</BrandButton>
  </section>
</div>
