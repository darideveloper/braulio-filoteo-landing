---
import clsx from 'clsx';

interface Props {
  icon: string;
  variant?: 'primary' | 'secondary' | 'muted' | 'white';
  class?: string;
}

const { icon, variant = 'primary', class: className } = Astro.props;

const variants = {
  primary: "text-brand-primary",
  secondary: "text-brand-secondary",
  muted: "text-brand-text-muted",
  white: "text-brand-text-high",
};
---

<span class={clsx("material-symbols-outlined", variants[variant], className)}>
  {icon}
</span>
