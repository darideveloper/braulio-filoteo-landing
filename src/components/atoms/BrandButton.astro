---
import clsx from 'clsx';

interface Props {
  variant?: 'primary' | 'primary-gradient' | 'secondary' | 'outline' | 'outline-secondary' | 'ghost';
  href?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  class?: string;
  icon?: string;
  circular?: boolean;
  [key: string]: any;
}

const { 
  variant = 'primary', 
  href,
  target,
  rel,
  disabled = false, 
  class: className,
  icon,
  circular = false,
  ...rest 
} = Astro.props;

const isExternal = target === '_blank';
const finalRel = rel || (isExternal ? 'noopener noreferrer' : undefined);

const variants = {
  primary: "bg-brand-primary text-white shadow-neon-purple hover:opacity-90 active:scale-95",
  'primary-gradient': "bg-brand-gradient text-white shadow-xl hover:scale-[1.05] transition-transform duration-500",
  secondary: "bg-brand-secondary text-white shadow-[0_10px_30px_-10px_rgba(254,101,0,0.4)] hover:opacity-90 active:scale-95",
  outline: "glass-surface border border-brand-surface-bright/30 text-brand-text-high hover:border-brand-secondary/50 active:scale-95",
  'outline-secondary': "border-2 border-brand-secondary text-brand-secondary hover:bg-brand-secondary hover:text-white transition-all duration-300",
  ghost: "bg-transparent text-brand-text-muted hover:text-brand-primary transition-colors",
};

const baseClasses = clsx(
  "inline-flex items-center justify-center gap-3 transition-all cursor-pointer select-none group",
  circular ? "p-6 rounded-full" : "px-10 py-5 rounded-[0.25rem] label-md"
);
const disabledClasses = "opacity-50 cursor-not-allowed pointer-events-none grayscale";

const Element = href ? 'a' : 'button';
---

<Element
  href={href}
  target={target}
  rel={finalRel}
  class={clsx(
    baseClasses,
    variants[variant],
    disabled && disabledClasses,
    className
  )}
  {...href ? {} : { disabled }}
  {...rest}
>
  <slot />
  {icon && (
    <span class={clsx(
      "material-symbols-outlined transition-transform",
      variant === 'primary' || variant === 'secondary' ? "group-hover:translate-x-1" : "text-brand-secondary"
    )}>
      {icon}
    </span>
  )}
</Element>
