---
import clsx from 'clsx';

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  disabled?: boolean;
  class?: string;
  [key: string]: any;
}

const { 
  variant = 'primary', 
  disabled = false, 
  class: className,
  ...rest 
} = Astro.props;

const variants = {
  primary: "bg-brand-gradient text-white shadow-neon-purple hover:opacity-90 active:scale-95",
  secondary: "bg-transparent border-2 border-brand-secondary text-brand-secondary hover:bg-brand-secondary/10 active:scale-95",
  outline: "bg-transparent border-2 border-brand-primary text-brand-primary hover:bg-brand-primary/10 active:scale-95",
  ghost: "bg-transparent text-brand-text-muted hover:text-brand-primary transition-colors",
};

const baseClasses = "inline-flex items-center justify-center min-w-[120px] px-6 py-3 label-md rounded-[0.25rem] transition-all cursor-pointer select-none";
const disabledClasses = "opacity-50 cursor-not-allowed pointer-events-none grayscale";
---

<button
  class={clsx(
    baseClasses,
    variants[variant],
    disabled && disabledClasses,
    className
  )}
  disabled={disabled}
  {...rest}
>
  <slot />
</button>
