---
const { color, label, role } = Astro.props;
---

<div class="flex flex-col gap-4 p-6 bg-brand-surface rounded-[0.5rem] transition-all hover:bg-brand-surface-bright group">
  <div 
    class="w-full h-32 rounded-[0.25rem] shadow-inner transition-transform group-hover:scale-[1.02]" 
    style={`background-color: ${color}`}
  ></div>
  <div class="flex flex-col gap-1">
    <span class="font-brand-display font-black uppercase text-xl tracking-tight leading-none text-brand-text-high">{label}</span>
    <span class="text-sm text-brand-text-muted leading-relaxed">{role}</span>
    <code class="text-xs mt-3 px-3 py-1 bg-brand-primary/10 text-brand-primary rounded-full self-start font-mono font-bold tracking-wider">
      {color}
    </code>
  </div>
</div>
