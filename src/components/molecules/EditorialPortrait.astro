---
import clsx from 'clsx';
import { Image } from 'astro:assets';

interface Props {
  src: string | any;
  alt: string;
  width?: number;
  height?: number;
  inferSize?: boolean;
  floatingLabel?: string;
  verticalText?: string;
  accent?: 'primary' | 'secondary';
  aspect?: string;
  showFrame?: boolean;
  framePosition?: 'top-right' | 'top-left';
  variant?: 'default' | 'minimal';
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
}

const { 
  src, 
  alt, 
  width,
  height,
  inferSize = true,
  floatingLabel, 
  verticalText,
  accent = 'primary',
  aspect = 'aspect-[4/5]',
  showFrame = true,
  framePosition = 'top-right',
  variant = 'default',
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async'
} = Astro.props;

const accentColors = {
  primary: {
    border: "border-brand-primary/30",
    text: "text-brand-secondary", // Floating label text uses secondary for contrast in design
  },
  secondary: {
    border: "border-brand-secondary/30",
    text: "text-brand-primary",
  }
};

const currentAccent = accentColors[accent];
const isMinimal = variant === 'minimal';
const shouldShowFrame = !isMinimal && showFrame;

const hasStatCard = Astro.slots.has('statCard');

const frameClasses = {
  'top-right': "-top-6 -right-6 border-t-2 border-r-2 group-hover:-top-4 group-hover:-right-4",
  'top-left': "-top-4 -left-4 border-t-2 border-l-2 group-hover:-top-2 group-hover:-left-2"
};
---

<div class={clsx("relative group js-portrait-container", className)} style="will-change: transform;">
  <!-- Decorative Frame Element -->
  {shouldShowFrame && (
    <div class={clsx(
      "absolute w-full h-full transition-all duration-700 js-portrait-frame",
      frameClasses[framePosition],
      currentAccent.border
    )} style="will-change: transform;"></div>
  )}
  
  <div class={clsx("relative overflow-hidden rounded-sm bg-brand-surface shadow-2xl", aspect)}>
    <Image 
      src={src} 
      alt={alt} 
      width={width}
      height={height}
      inferSize={inferSize}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      class="w-full h-full object-cover img-editorial js-portrait-img" 
      style="will-change: transform;"
    />
    
    <!-- Image Overlay Gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-brand-background via-transparent to-transparent opacity-60"></div>
    
    <!-- Floating Label -->
    {!isMinimal && floatingLabel && (
      <div class="absolute bottom-8 right-8 glass-surface p-4 border border-brand-surface-bright/30 js-portrait-label">
        <span class={clsx(
          "font-brand-display font-black text-xl tracking-tighter uppercase",
          currentAccent.text
        )}>
          {floatingLabel}
        </span>
      </div>
    )}
  </div>

  <!-- Stat Card Slot -->
  {hasStatCard && (
    <div class="absolute -bottom-6 -right-6 p-8 bg-brand-background border border-brand-outline-variant/10 shadow-2xl z-20">
      <slot name="statCard" />
    </div>
  )}

  <!-- Side Text Element -->
  {!isMinimal && verticalText && (
    <div class="absolute -left-12 top-1/2 -rotate-90 origin-center hidden @lg:block">
      <span class="font-brand-body text-[10px] tracking-[1em] text-brand-text-muted/40 font-bold uppercase whitespace-nowrap">
        {verticalText}
      </span>
    </div>
  )}
</div>
