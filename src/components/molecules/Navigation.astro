---
import clsx from 'clsx';
import { navItems } from '../../config/navigation';
import MaterialIcon from '../atoms/MaterialIcon.astro';

interface Props {
  className?: string;
  itemClassName?: string;
}

const { className, itemClassName } = Astro.props;
---

<nav class={clsx("flex flex-col gap-0", className)}>
  {navItems.map((item) => (
    <a
      href={item.href}
      class={clsx(
        "flex items-center gap-4 py-3 text-brand-text-muted transition-all duration-300 hover:text-brand-primary group relative",
        itemClassName
      )}
    >
      <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-brand-surface-low border border-brand-outline-variant/30 transition-all duration-300 group-hover:bg-brand-primary/10 group-hover:border-brand-primary/50 group-hover:shadow-neon-purple">
        <MaterialIcon 
          name={item.icon} 
          class="text-xl transition-transform duration-300 group-hover:scale-110" 
        />
      </div>
      
      <span class="label-md tracking-[0.2em] font-brand-display text-[0.7rem] transition-colors duration-300 group-hover:text-brand-text-high">
        {item.label}
      </span>

      {/* Active Indicator (subtle dot or line) */}
      <div class="absolute -left-8 w-1 h-0 bg-brand-primary transition-all duration-300 group-hover:h-6 rounded-full"></div>
    </a>
  ))}
</nav>
