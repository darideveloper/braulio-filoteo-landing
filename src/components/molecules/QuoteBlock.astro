---
import clsx from 'clsx';
import AboutIcon from '../atoms/AboutIcon.astro';

interface Props {
  text: string;
  author: string;
  class?: string;
}

const { text, author, class: className } = Astro.props;
---

<div class={clsx(
  "bg-brand-primary/5 border border-brand-primary/20 p-12 rounded-[3rem] relative",
  className
)}>
  <AboutIcon icon="format_quote" variant="primary" class="absolute -top-6 -left-6 !text-7xl opacity-20" />
  <p class="text-2xl @md:text-3xl font-brand-body font-light text-brand-text-high leading-relaxed italic">
    "{text}"
  </p>
  <div class="mt-8 flex items-center gap-4">
    <div class="h-px w-12 bg-brand-primary"></div>
    <span class="font-brand-body font-bold tracking-[0.2em] uppercase text-[10px] text-brand-text-high">
      {author}
    </span>
  </div>
</div>
