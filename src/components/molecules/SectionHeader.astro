---
import clsx from 'clsx';

interface Props {
  label: string;
  title?: string;
  description?: string;
  level?: 1 | 2;
  align?: 'left' | 'center';
  size?: 'standard' | 'editorial';
  maxWidth?: string;
  labelColor?: string;
  titleColor?: string;
  titleClass?: string;
  withBorder?: boolean;
  layout?: 'standard' | 'inline' | 'inline-start';
  class?: string;
}

const { 
  label, 
  title, 
  description, 
  level = 2,
  align = 'left',
  size = 'standard',
  maxWidth,
  labelColor = "text-brand-primary", 
  titleColor = "text-brand-text-high",
  titleClass,
  withBorder = false,
  layout = 'standard',
  class: className 
} = Astro.props;

const Tag = level === 1 ? 'h1' : 'h2';
const hasTitleSlot = Astro.slots.has('title');

const isInline = layout === 'inline';
const isInlineStart = layout === 'inline-start';

const sizeClasses = {
  standard: "display-lg normal-case !text-[2.5rem] @3xl:!text-[3.5rem] !leading-[1.1] tracking-[-0.04em]",
  editorial: "text-5xl @3xl:text-7xl @5xl:text-8xl font-black font-brand-display tracking-[-0.06em] leading-tight"
};
---

<div class={clsx(
  "flex flex-col gap-4",
  align === 'center' && "items-center text-center",
  className
)} style={maxWidth ? { maxWidth } : {}}>
  {isInline ? (
    <div class="flex flex-col @3xl:flex-row justify-between items-baseline mb-12 gap-4">
      <Tag class={clsx(
        sizeClasses[size],
        titleColor,
        "uppercase",
        titleClass
      )}>
        {hasTitleSlot ? <slot name="title" /> : title}
      </Tag>
      <div class="h-px flex-grow mx-8 bg-brand-outline-variant/20 hidden @3xl:block"></div>
      <span class={clsx(
        "label-md tracking-tight uppercase",
        labelColor
      )}>
        {label}
      </span>
    </div>
  ) : isInlineStart ? (
    <div class="flex flex-col @3xl:flex-row items-baseline gap-4 mb-12">
      <span class={clsx(
        "label-md tracking-[0.2em] uppercase",
        labelColor
      )}>
        {label}
      </span>
      <Tag class={clsx(
        sizeClasses[size],
        titleColor,
        "uppercase",
        titleClass
      )}>
        {hasTitleSlot ? <slot name="title" /> : title}
      </Tag>
    </div>
  ) : (
    <>
      <span class={clsx(
        "label-md tracking-[0.4em] uppercase",
        labelColor
      )}>
        {label}
      </span>
      
      <Tag class={clsx(
        sizeClasses[size],
        titleColor,
        titleClass
      )}>
        {hasTitleSlot ? <slot name="title" /> : title}
      </Tag>
    </>
  )}

  {description && (
    <p class={clsx(
      "headline-md text-brand-text-high max-w-3xl mt-2",
      withBorder && "border-l-4 border-brand-primary pl-6",
      align === 'center' && "mx-auto"
    )}>
      {description}
    </p>
  )}
  
  <slot />
</div>
