---
import clsx from 'clsx';
import MaterialIcon from '../atoms/MaterialIcon.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  footerLabel: string;
  span?: 1 | 2 | 4;
  variant?: 'default' | 'gradient';
  class?: string;
}

const { 
  title, 
  description, 
  icon, 
  footerLabel, 
  span = 1, 
  variant = 'default',
  class: className 
} = Astro.props;

const spanClasses = {
  1: "md:col-span-1",
  2: "md:col-span-2",
  4: "md:col-span-4"
};

const isBanner = span === 4;
const isGradient = variant === 'gradient';
---

<div class={clsx(
  "p-10 flex flex-col justify-between group transition-colors duration-500 min-h-[400px]",
  spanClasses[span],
  !isGradient && "bg-brand-surface-low hover:bg-brand-surface-container",
  isGradient && "bg-gradient-to-r from-brand-surface-low to-brand-surface-bright border-l-4 border-brand-primary",
  className
)}>
  <div class={clsx("flex flex-col", isBanner && "md:flex-row md:items-start justify-between gap-8")}>
    <div class={clsx(isBanner && "max-w-xl")}>
      <MaterialIcon name={icon} size="text-4xl" class="text-brand-secondary mb-6 block" />
      <h3 class={clsx(
        "font-bold font-brand-display text-brand-text-high mb-4 uppercase",
        isBanner ? "text-3xl md:text-4xl" : "text-2xl"
      )}>
        {title}
      </h3>
      <p class="text-brand-text-muted leading-relaxed font-light">
        {description}
      </p>
    </div>
    
    {isBanner && (
      <div class="mt-8 md:mt-0">
        <slot name="cta" />
      </div>
    )}
  </div>

  <div class="flex items-center gap-4 mt-8">
    {!isBanner && (
       <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-brand-text-muted/60">
        {footerLabel}
      </span>
    )}
    
    {isBanner && (
      <>
        <div class="w-12 h-px bg-brand-primary/40 group-hover:w-24 transition-all duration-500"></div>
        <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-brand-primary">
          {footerLabel}
        </span>
      </>
    )}
  </div>
</div>
