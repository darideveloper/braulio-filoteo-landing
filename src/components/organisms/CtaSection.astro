---
import clsx from 'clsx'
import type { SectionProps } from '../../types/Section';
import MaterialIcon from '../atoms/MaterialIcon.astro'
import SectionHeader from '../molecules/SectionHeader.astro'

interface Props extends Partial<SectionProps> {
  label?: string
  watermark?: string
  showContact?: boolean
  class?: string
}

const { 
  id,
  label = "CONTACTO",
  watermark, 
  showContact = false, 
  class: className 
} = Astro.props
---

<section
  id={id}
  class={clsx(
    'relative min-h-screen flex items-center justify-center w-full py-24 px-6 bg-black overflow-hidden',
    className,
  )}
>
  <div class='max-w-4xl mx-auto relative z-10 w-full'>
    <SectionHeader 
      label={label}
      align="center"
      size="editorial"
      titleColor="text-brand-text-high"
      class="mb-12"
    >
      <slot name="headline" slot="title" />
      <slot name="description" />
    </SectionHeader>

    <div class='flex flex-col @xl:flex-row items-center justify-center gap-6'>
      <slot name='cta' />
      {
        showContact && (
          <div class='flex items-center gap-4 text-sm font-bold tracking-widest uppercase text-brand-text-muted'>
            <MaterialIcon
              name='mail'
              class='text-brand-secondary'
            />
            <a href="mailto:info@grit-ones.com" class="hover:text-brand-secondary transition-colors">info@grit-ones.com</a>
          </div>
        )
      }
    </div>
  </div>

  {
    watermark && (
      <div class='absolute inset-0 z-0 flex items-center justify-center pointer-events-none'>
        <span class='text-watermark'>{watermark}</span>
      </div>
    )
  }
</section>
