---
import clsx from 'clsx';
import type { SectionProps } from '../../types/Section';
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from '../molecules/SectionHeader.astro';
import ServiceCard from '../molecules/ServiceCard.astro';
import BrandButton from '../atoms/BrandButton.astro';

interface Service {
  title: string;
  description: string;
  icon: string;
  footerLabel: string;
  span?: 1 | 2 | 4;
  variant?: 'default' | 'gradient';
}

interface Props extends Partial<SectionProps> {
  title: string;
  label: string;
  subtitle: string;
  services: Service[];
  class?: string;
}

const { id = 'services', title, label, subtitle, services, class: className } = Astro.props;
---

<SectionWrapper id={id} class={clsx("py-24 js-gritones-section", className)}>
  <SectionHeader 
    layout="inline"
    title={title}
    label={label}
    description={subtitle}
    class="mb-16 js-gritones-header js-gritones-reveal opacity-0"
  />

  <div class="grid grid-cols-1 @5xl:grid-cols-4 gap-4">
    {services.map((service) => (
      <ServiceCard {...service} class="js-gritones-card js-gritones-reveal opacity-0">
        {service.span === 4 && (
          <BrandButton slot="cta" variant="outline" icon="arrow_forward">
            Explorar Portafolio
          </BrandButton>
        )}
      </ServiceCard>
    ))}
  </div>
</SectionWrapper>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Register plugin locally to ensure it is available in this scope
  gsap.registerPlugin(ScrollTrigger);

  function initGritonesAnimations() {
    const section = document.querySelector('.js-gritones-section');
    if (!section) return;

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Unhide elements for GSAP to capture the correct natural state
      // We target only elements within THIS section context to avoid global side-effects
      gsap.set(section.querySelectorAll(".js-gritones-reveal"), { 
        autoAlpha: 1,
        force3D: true
      });
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          toggleActions: "play none none none"
        }
      });

      tl.from(".js-gritones-header", {
        autoAlpha: 0,
        y: 40,
        duration: 1.2,
        ease: "power4.out"
      })
      .from(".js-gritones-card", {
        autoAlpha: 0,
        y: 30,
        duration: 1.0,
        stagger: 0.15,
        ease: "power3.out"
      }, "-=0.8");
    });

    // Fallback for reduced motion: only fade in
    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(section.querySelectorAll(".js-gritones-reveal"), { autoAlpha: 0 });
      
      ScrollTrigger.create({
        trigger: section,
        start: "top 80%",
        onEnter: () => {
          gsap.to(section.querySelectorAll(".js-gritones-reveal"), {
            autoAlpha: 1,
            duration: 0.8,
            stagger: 0.1
          });
        }
      });
    });
  }

  // Initialize
  initGritonesAnimations();
</script>
