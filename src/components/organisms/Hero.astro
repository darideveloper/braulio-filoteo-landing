---
import clsx from 'clsx';
import BrandButton from '../atoms/BrandButton.astro';
---

<section class={clsx("relative min-h-[80vh] flex flex-col items-center justify-center text-center px-6 py-[8.5rem] bg-brand-background overflow-hidden group")}>
  <div class="absolute inset-0 bg-glow-purple opacity-30 group-hover:opacity-40 transition-opacity"></div>
  
  <div class="container relative z-10 grid grid-cols-1 gap-16 max-w-6xl mx-auto">
    <div class="space-y-8">
      <h1 class="display-lg text-7xl sm:text-8xl md:text-9xl text-brand-secondary">
        BRAULIO <br class="hidden sm:block" /> FILOTEO<span class="text-brand-primary">.</span>
      </h1>
      
      <p class="text-2xl sm:text-3xl text-brand-text-muted max-w-2xl mx-auto font-brand-body font-light leading-relaxed">
        Building <span class="text-brand-text-high font-bold italic">bold identities</span> and digital social hubs for the modern era of community.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-10 pt-6">
      <BrandButton>View the Portfolio</BrandButton>
      <a 
        href="#contact" 
        class="text-brand-secondary label-md text-lg hover:text-brand-primary transition-colors pb-1"
      >
        Get in touch
      </a>
    </div>
  </div>
</section>
