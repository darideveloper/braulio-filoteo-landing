---
import clsx from 'clsx';
import Badge from '../atoms/Badge.astro';
import BrandButton from '../atoms/BrandButton.astro';
import StatItem from '../atoms/StatItem.astro';
import EditorialPortrait from '../molecules/EditorialPortrait.astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-brand-background">
  <!-- Ambient Glow Effects -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-brand-primary/10 rounded-full blur-[120px]"></div>
  <div class="absolute bottom-1/4 -right-20 w-[500px] h-[500px] bg-brand-secondary/5 rounded-full blur-[150px]"></div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Hero Content -->
      <div class="lg:col-span-7 flex flex-col items-start order-2 lg:order-1">
        <div class="flex flex-wrap gap-3 mb-8">
          <Badge>HOST</Badge>
          <Badge>ENTREPRENEUR</Badge>
          <Badge>CO-FOUNDER</Badge>
        </div>

        <h2 class="font-brand-display text-brand-text-muted/60 text-sm md:text-base font-bold tracking-[0.3em] uppercase mb-4">
          COLECCIONISTA DE HISTORIAS HUMANAS
        </h2>

        <div class="mb-2">
          <span class="font-brand-display text-xs md:text-sm font-bold tracking-[0.5em] text-brand-text-muted italic uppercase opacity-70">
            ENDURE TO SHINE
          </span>
        </div>

        <h1 class="headline-xl text-5xl md:text-8xl text-brand-text-high mb-8">
          BRAULIO <br/> FILOTEO
        </h1>

        <p class="font-brand-body text-lg md:text-2xl text-brand-text-muted max-w-xl leading-relaxed mb-10">
          Exploro conversaciones que revelan propósito, carácter y legado.
        </p>

        <div class="flex flex-col sm:flex-row gap-5 w-full sm:w-auto">
          <BrandButton variant="secondary" icon="play_circle">
            Escucha GRITones
          </BrandButton>
          <BrandButton variant="outline" icon="mic">
            Crea tu podcast
          </BrandButton>
        </div>

        <!-- Micro-credibility Stats & Titles -->
        <div class="mt-16 flex flex-col md:flex-row gap-8 items-start">
          <StatItem 
            value="100+" 
            label="Host de GRITones Podcast" 
            variant="primary" 
          />
          <StatItem 
            value="30+" 
            label="Emprendedor | Cofundador de GRITones Studio" 
            variant="secondary" 
          />
        </div>
      </div>

      <!-- Hero Image Portrait Area -->
      <div class="lg:col-span-5 order-1 lg:order-2">
        <EditorialPortrait 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuC7YTGptSm0JHvGo-qJutMtIDx4Gpnm6zo2C1PXLRmBX5DztrEgA2jKVoZM1Rje0I_dJrF04UjNPefqBoe7fSCsyNHaLqxIDlyZ-fxC2PjPYNnN1oRtENymQaPoBv56aXmn8IIMeCwwhjeSKqj-xqXjrlbFfmM9fYIt8AlFFocph-v33VWk7-r23_g10yCAz82GAjxYFPvkDF9VuP8tcnzZlrcBSEzUd2l2VU5rfcUSsCJ5_BLoNWjVTLNdg8a3ufZ4ErFnwvU5gPQ"
          alt="Braulio Filoteo Editorial Portrait"
          floatingLabel="EST. 2024"
          verticalText="DOCUMENTING HUMAN POTENTIAL"
        />
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-40">
    <span class="font-brand-body text-[10px] tracking-[0.3em] uppercase">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-brand-primary to-transparent"></div>
  </div>
</section>
