---
import { Image } from 'astro:assets'
import clsx from 'clsx'
import SideBorderQuote from '../molecules/SideBorderQuote.astro'
import MaterialIcon from '../atoms/MaterialIcon.astro'
import SectionHeader from '../molecules/SectionHeader.astro'
import SectionWrapper from './SectionWrapper.astro'
import SocialIcon from '../atoms/SocialIcon.astro'
import type { SectionProps } from '../../types/Section'

import avatarMale from '../../assets/images/avatar-male.svg'
import avatarFemale from '../../assets/images/avatar-female.svg'
import BraulioPhoto from '../../assets/images/braulio-photo.webp'

interface Props extends Partial<SectionProps> {
  class?: string
}

const { id = 'newsletter', variant = 'lowest', class: className } = Astro.props

const features = [
  { icon: 'mic_external_on', label: 'Audios Inéditos' },
  { icon: 'history_edu', label: 'Ensayos Semanales' },
]

const kineticWords = [
  { text: 'DISCIPLINA', variant: 'stroke' },
  { text: 'CARÁCTER', variant: 'filled' },
  { text: 'LIDERAZGO', variant: 'stroke' },
  { text: 'GRIT', variant: 'filled' },
]
---

<SectionWrapper
  id={id}
  variant={variant}
  class={clsx('bg-noir-gradient js-newsletter-section', className)}
  containerClass='w-full text-center space-y-12 '
>
  <!-- Atmospheric Glow Elements -->
  <div
    class='absolute top-1/4 -left-24 w-96 h-96 bg-brand-primary/10 rounded-full blur-[60px] pointer-events-none js-newsletter-glow'
    style='will-change: transform;'
  >
  </div>
  <div
    class='absolute bottom-1/4 -right-24 w-96 h-96 bg-brand-secondary/5 rounded-full blur-[60px] pointer-events-none js-newsletter-glow'
    style='will-change: transform;'
  >
  </div>

  <!-- Editorial Overline -->
  <SectionHeader
    label='Membresía Privada'
    align='center'
    size='editorial'
    titleColor='text-brand-secondary'
    class='js-newsletter-header js-reveal'
    style='will-change: transform;'
  >
    <Fragment slot='title'>
      GRIT <span class='text-brand-text-high'>en la vida cotidiana</span>
    </Fragment>
  </SectionHeader>

  <!-- Descriptive Content Cluster -->
  <div class='grid grid-cols-1 @md:grid-cols-12 gap-8 items-start'>
    <div class='@md:col-span-12 space-y-6'>
      <SideBorderQuote
        class='text-xl @md:text-2xl font-light text-brand-text-high text-left max-w-2xl mx-auto js-newsletter-quote js-reveal'
      >
        "Reflexiones en audio y texto sobre liderazgo, decisiones difíciles y el poder de la resiliencia"
      </SideBorderQuote>

      <div
        class='max-w-xl mx-auto space-y-4 js-newsletter-content js-reveal'
        style='will-change: transform;'
      >
        <p
          class='text-brand-text-muted font-brand-body leading-relaxed text-lg'
        >
          Lo que no cuento en el podcast, lo envío por aquí. Reflexiones crudas
          sobre el camino del líder, enviadas en formato de audio corto y texto
          para leer en 3 minutos.
        </p>
        <div class='flex flex-wrap justify-center gap-4 py-4'>
          {
            features.map((feature) => (
              <div class='flex items-center gap-2 text-brand-text-high text-sm font-brand-body uppercase tracking-widest font-bold js-newsletter-feature js-reveal'>
                <MaterialIcon
                  name={feature.icon}
                  class='text-brand-secondary text-lg'
                />
                {feature.label}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Substack Embed Section -->
  <div
    class='w-full pt-8 js-newsletter-embed js-reveal'
    style='will-change: transform;'
  >
    <div class='py-16 bg-[#000000]'>
      <div class='relative flex items-center justify-center flex-col gap-4'>
        <div class='flex items-center gap-4'>
          <Image
            src={BraulioPhoto}
            alt='Braulio Filoteo'
            width={80}
            height={80}
            class='mx-auto rounded-full'
          />
          <h3 class='text-white text-2xl font-bold text-left'>
            <span class='block'> Braulio Filoteo </span>
            <span class='flex items-center gap-2 text-brand-secondary text-xl'>
              <SocialIcon platform="Substack" class="text-xl" />
              Substack
            </span>
          </h3>
        </div>
        <iframe
          id='substack-iframe'
          src='https://brauliofiloteo.substack.com/embed?minimal=true'
          width='350'
          height='160'
          frameborder='0'
          scrolling='no'
          title='Suscripción a la Membresía Privada en Substack'
          class='invert-100 hue-rotate-180 scale-100 sm:scale-125 origin-top'
        ></iframe>
      </div>
    </div>
  </div>

  <!-- Social Proof & Footer Container -->
  <div class='container mt-4 space-y-8 js-newsletter-proof js-reveal'>
    <!-- Adblocker Fallback -->
    <p class='text-brand-text-muted font-brand-body text-xs'>
      ¿No ves el formulario? <a
        href='https://brauliofiloteo.substack.com'
        target='_blank'
        rel='noopener noreferrer'
        class='underline text-brand-secondary hover:text-brand-primary transition-colors'
        >Suscríbete aquí</a
      >.
    </p>

    <!-- Value Proposition & Social Proof -->
    <div class='mt-8 space-y-4'>
      <p
        class='text-brand-text-muted font-brand-body font-bold text-xs uppercase tracking-[0.15em] leading-relaxed max-w-lg mx-auto'
      >
        Una dosis semanal de carácter directa a tu bandeja de entrada. Menos
        ruido, más profundidad. Incluye acceso a audios exclusivos no publicados
        en el podcast.
      </p>

      <div class='flex items-center justify-center gap-3 pt-4'>
        <div class='flex -space-x-2'>
          <div
            class='w-8 h-8 rounded-full border border-brand-background bg-brand-surface-bright flex items-center justify-center overflow-hidden'
          >
            <Image
              src={avatarMale}
              alt='Líder suscrito'
              width={32}
              height={32}
              class='w-full h-full object-cover'
            />
          </div>
          <div
            class='w-8 h-8 rounded-full border border-brand-background bg-brand-surface-bright flex items-center justify-center overflow-hidden'
          >
            <Image
              src={avatarFemale}
              alt='Líder suscrita'
              width={32}
              height={32}
              class='w-full h-full object-cover'
            />
          </div>
          <div
            class='w-8 h-8 rounded-full border border-brand-background bg-brand-primary flex items-center justify-center text-[10px] font-bold text-white'
          >
            +2k
          </div>
        </div>
        <p class='text-brand-text-muted text-xs italic font-brand-body'>
          Únete a +2,500 líderes que ya reciben GRIT. Sin spam. Solo historias
          que construyen carácter.
        </p>
      </div>
    </div>
  </div>

  <!-- Kinetic Scroller Decoration (Subtle Visual Interest) -->
  <div
    class='absolute bottom-0 left-0 w-full overflow-hidden opacity-5 pointer-events-none'
  >
    <div class='flex gap-4 p-8 whitespace-nowrap'>
      {
        kineticWords.map((word) => (
          <span
            class={clsx(
              'text-9xl font-black font-brand-display uppercase',
              word.variant === 'stroke'
                ? 'text-stroke-brand'
                : 'text-brand-text-high',
            )}
          >
            {word.text}
          </span>
        ))
      }
    </div>
  </div>
</SectionWrapper>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initNewsletterAnimations() {
    const section = document.querySelector('.js-newsletter-section')
    if (!section) return

    const mm = gsap.matchMedia()

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // 1. Unhide elements for GSAP to capture correct natural state
      gsap.set(section.querySelectorAll('.js-reveal'), { autoAlpha: 1, force3D: true })
      gsap.set(section.querySelectorAll('.js-newsletter-glow'), { autoAlpha: 1 })

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      })

      tl.from(section.querySelectorAll('.js-newsletter-glow'), {
        autoAlpha: 0,
        duration: 2.0,
        ease: 'power2.inOut',
      })
        .from(
          section.querySelector('.js-newsletter-header'),
          {
            autoAlpha: 0,
            y: 40,
            duration: 1.2,
            delay: 0.3,
            ease: 'power4.out',
          },
          0,
        )
        .from(
          section.querySelector('.js-newsletter-quote'),
          {
            autoAlpha: 0,
            x: -20,
            duration: 1.2,
            ease: 'power3.out',
          },
          '-=0.8',
        )
        .from(
          section.querySelector('.js-newsletter-content'),
          {
            autoAlpha: 0,
            y: 20,
            duration: 1.0,
            ease: 'power2.out',
          },
          '-=0.6',
        )
        .from(
          section.querySelectorAll('.js-newsletter-feature'),
          {
            autoAlpha: 0,
            y: 10,
            stagger: 0.1,
            duration: 0.8,
            ease: 'power2.out',
          },
          '-=0.4',
        )
        .from(
          section.querySelector('.js-newsletter-embed'),
          {
            autoAlpha: 0,
            scale: 0.98,
            y: 20,
            duration: 1.2,
            ease: 'expo.out',
          },
          '-=0.5',
        )
        .from(
          section.querySelector('.js-newsletter-proof'),
          {
            autoAlpha: 0,
            y: 15,
            duration: 1.0,
            ease: 'power2.out',
          },
          '-=0.8',
        )
    })

    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set(section.querySelectorAll('.js-reveal'), { autoAlpha: 0 })
      gsap.set(section.querySelectorAll('.js-newsletter-glow'), { autoAlpha: 0 })

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      })

      tl.to(
        [
          ...section.querySelectorAll('.js-newsletter-glow'),
          ...section.querySelectorAll('.js-reveal'),
        ],
        {
          autoAlpha: 1,
          duration: 0.8,
          stagger: 0.1,
        },
      )
    })
  }

  initNewsletterAnimations()
</script>
