---
import type { SectionProps } from '../../types/Section';
import SectionWrapper from './SectionWrapper.astro';
import PillarCard from '../molecules/PillarCard.astro';

interface Props extends Partial<SectionProps> {}

const { id } = Astro.props;

const pillars = [
  {
    number: "01",
    icon: "lightbulb",
    title: "Propósito",
    description: "Descubrir tu por qué. La brújula estratégica que define cada movimiento de tu marca.",
    variant: "lowest" as const
  },
  {
    number: "02",
    icon: "auto_stories",
    title: "Storytelling",
    description: "Ordenar tu historia. Convertir el caos de la experiencia en una narrativa cautivadora.",
    variant: "low" as const
  },
  {
    number: "03",
    icon: "record_voice_over",
    title: "Voz",
    description: "Convertir conversación en contenido. Encontrar el tono único que resonará en tu audiencia.",
    variant: "lowest" as const
  },
  {
    number: "04",
    icon: "verified",
    title: "Marca personal",
    description: "Transformar experiencia en autoridad. Posicionarte como el referente indiscutible de tu nicho.",
    variant: "low" as const
  }
];
---

<SectionWrapper
  id={id}
  label="Metodología"
  title="PILARES"
  headerLayout="inline-start"
  headerClass="mb-16"
  containerClass="pt-32"
  titleColor="text-brand-secondary"
  labelColor="text-brand-text-muted"
  size="editorial"
>
  <div class="grid grid-cols-1 @xl:grid-cols-2 @6xl:grid-cols-4 gap-1">
    {pillars.map((pillar) => (
      <PillarCard {...pillar} />
    ))}
  </div>
</SectionWrapper>
