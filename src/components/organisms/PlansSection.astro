---
import clsx from 'clsx'
import type { SectionProps } from '../../types/Section'
import SectionWrapper from './SectionWrapper.astro'
import SectionHeader from '../molecules/SectionHeader.astro'
import PlansCard from '../molecules/PlansCard.astro'
import MaterialIcon from '../atoms/MaterialIcon.astro'

interface Props extends Partial<SectionProps> {
  class?: string
}

const { id = 'plans', class: className } = Astro.props

const plans = [
  {
    variant: 'entry' as const,
    icon: 'bolt',
    badge: 'Entry Level',
    title: 'Podcast Express',
    subtitle: 'Lanza tu podcast en menos de 48 horas.',
    features: [
      'Arquitectura de marca personal',
      'Naming & Portada',
      'Tráiler & Publicación',
    ],
    result: {
      label: 'Resultado directo',
      value: 'Sales con tu podcast publicado.',
    },
    cta: {
      label: 'Ver próxima inmersión',
      href: 'https://www.lanzaunpodcast.com/org',
      target: '_blank',
    },
    colSpan: '@4xl:col-span-5',
    id: 'podcast-express',
  },
  {
    variant: 'premium' as const,
    icon: 'auto_awesome',
    badge: 'Advanced / Mentoría',
    title: '5 pasos para acelera',
    subtitle:
      'Acelera tu marca personal con un podcast estratégico. Rapidez, exclusividad y personalizacién',
    features: [
      'Posicionamiento',
      'Storytelling',
      'Crecimiento de audiencia',
      'Autoridad digital',
    ],
    cta: {
      label: 'Aplicar al programa',
      href: 'https://calendly.com/braulio-grit-ones/30min?primary_color=ff7100',
      target: '_blank',
    },
    colSpan: '@4xl:col-span-7',
    id: 'podcast-pro',
  },
]
---

<SectionWrapper
  id={id}
  containerClass='container'
  class={clsx('py-24 js-plans-section', className)}
>
  <div class='relative js-plans-header js-plans-reveal opacity-0'>
    <SectionHeader
      label='ECOSISTEMA'
      title='Consolida tu Marca Personal'
      description='Dos caminos para convertir tu voz en una plataforma real.'
      withBorder
      class='mb-24'
    />

    {/* Decorative Glow */}
    <div
      class='absolute -top-20 -left-20 w-96 h-96 bg-brand-primary/10 blur-[120px] rounded-full -z-10 js-plans-glow js-plans-reveal opacity-0'
    >
    </div>
  </div>

  <div class='grid grid-cols-1 @4xl:grid-cols-12 gap-8'>
    {
      plans.map(({ colSpan, ...planProps }) => (
        <div class={clsx(colSpan, 'js-plans-card js-plans-reveal opacity-0')}>
          <PlansCard {...planProps} />
        </div>
      ))
    }
  </div>

  {/* Section Outro */}
  <footer
    class='mt-32 border-t border-brand-outline-variant/10 pt-12 flex flex-col @md:flex-row items-end justify-between gap-8 js-plans-footer js-plans-reveal opacity-0'
  >
    <div class='max-w-md'>
      <h3
        class='font-brand-display text-2xl font-bold text-brand-text-high mb-4 uppercase italic'
      >
        ¿No sabes cuál elegir?
      </h3>
      <p class='text-brand-text-muted text-sm leading-relaxed'>
        Agenda una llamada de claridad de 15 minutos para analizar tu situación
        actual y determinar el mejor punto de partida para tu proyecto.
      </p>
    </div>

    <a
      class='inline-flex items-center gap-4 group'
      href='https://api.whatsapp.com/send?phone=5219211697515'
      target='_blank'
      rel='noopener noreferrer'
    >
      <span
        class='font-brand-display font-black uppercase text-brand-secondary tracking-tighter text-xl'
      >
        ESCRIBENOS
      </span>
      <MaterialIcon
        name='arrow_forward'
        class='text-brand-secondary group-hover:translate-x-2 transition-transform'
      />
    </a>
  </footer>
</SectionWrapper>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  // Register plugin locally
  gsap.registerPlugin(ScrollTrigger)

  function initPlansAnimations() {
    const section = document.querySelector('.js-plans-section')
    if (!section) return

    const mm = gsap.matchMedia()

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // Unhide elements for GSAP to capture the correct natural state
      gsap.set(section.querySelectorAll('.js-plans-reveal'), {
        autoAlpha: 1,
        force3D: true,
      })

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      })

      tl.from('.js-plans-glow', {
        autoAlpha: 0,
        scale: 0.8,
        duration: 2,
        ease: 'power2.out',
      })
        .from(
          '.js-plans-header',
          {
            autoAlpha: 0,
            y: 40,
            duration: 1.2,
            ease: 'power4.out',
          },
          '-=1.5',
        )
        .from(
          '.js-plans-card',
          {
            autoAlpha: 0,
            y: 60,
            duration: 1.2,
            stagger: 0.2,
            ease: 'expo.out',
          },
          '-=0.8',
        )
        .from(
          '.js-plans-footer',
          {
            autoAlpha: 0,
            y: 20,
            duration: 1,
            ease: 'power3.out',
          },
          '-=0.6',
        )
    })

    // Fallback for reduced motion: only fade in
    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set(section.querySelectorAll('.js-plans-reveal'), { autoAlpha: 0 })

      ScrollTrigger.create({
        trigger: section,
        start: 'top 75%',
        onEnter: () => {
          gsap.to(section.querySelectorAll('.js-plans-reveal'), {
            autoAlpha: 1,
            duration: 0.8,
            stagger: 0.1,
          })
        },
      })
    })
  }

  // Initialize
  initPlansAnimations()
</script>
