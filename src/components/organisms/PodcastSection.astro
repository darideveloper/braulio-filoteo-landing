---
import clsx from 'clsx';
import type { SectionProps } from '../../types/Section';
import SectionHeader from '../molecules/SectionHeader.astro';
import SideBorderQuote from '../molecules/SideBorderQuote.astro';
import SpotifyEmbed from '../atoms/SpotifyEmbed.astro';
import PodcastCTA from '../molecules/PodcastCTA.astro';
import BrandButton from '../atoms/BrandButton.astro';

interface Props extends Partial<SectionProps> {
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section id={id} class={clsx("relative min-h-screen flex items-center w-full py-24 px-6 @md:px-12 @lg:px-24 overflow-hidden bg-brand-background", className)}>
  <!-- Ambient Glow Effects -->
  <div class="absolute top-0 right-0 -z-10 w-[500px] h-[500px] bg-brand-primary/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -z-10 w-[400px] h-[400px] bg-brand-secondary/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto max-w-screen-2xl relative z-10 w-full">
    <!-- Header Section -->
    <div class="grid grid-cols-1 @2xl:grid-cols-12 gap-12 items-end mb-16">
      <div class="@2xl:col-span-8">
        <SectionHeader 
          label="Editorial Series" 
          title="GRITones Podcast"
          labelColor="text-brand-primary-light"
          titleColor="text-brand-secondary"
          description="Donde las historias de fracaso se convierten en manuales de éxito. Únete a más de +100 conversaciones con líderes que se atrevieron a endurecer para brillar."
        />
      </div>
      <div class="@2xl:col-span-4 pb-2">
        <SideBorderQuote class="text-brand-text-high font-brand-body text-lg leading-relaxed">
          Conversaciones con personas que transformaron momentos difíciles en carácter. La prueba de que el Grit es el activo más valioso de un líder.
        </SideBorderQuote>
      </div>
    </div>

    <!-- Spotify Embed -->
    <div class="mb-24">
      <SpotifyEmbed url="https://open.spotify.com/show/2v8G6l6f6j9S9Z9O9N9I9" />
    </div>

    <!-- CTA Section -->
    <div class="flex flex-col items-center mb-24">
      <PodcastCTA 
        title="¿Tienes una historia que merece ser escuchada?"
        description="Llevamos tu mensaje al siguiente nivel con Podcast Express."
        href="#"
      />
    </div>

    <!-- Explore Button -->
    <div class="flex flex-col items-center">
      <BrandButton variant="outline" class="!px-12 !py-5 uppercase tracking-[0.2em]">
        Explorar todos los episodios
      </BrandButton>
    </div>
  </div>
</section>
