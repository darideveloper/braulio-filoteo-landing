    alt: "Braulio Editorial Portrait 1"
  },
  {
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuB-JfvosJrjN1_vz4G4fC95wTDwyTCQKnyeUFfAWyshOv5gI_aZ4UchsQjPMUSMqbcjpGX_3q0Tra7QXNdsAVARpbJQBftSrd8l1lxFqU7x6mh6dSeSU6Sp4p2pOnf8HeGuNW7DNSjPOq7N5y_AAQzEFuJEAq7Wd7lgHsZHQ43J7ptMS5_ZQ49S1FZzKpvf6uSt108HNTHRB8BK8XE9U1VPcsg9TUN0V4-dQLGfgf2YyIpKaLEFIy_yaKpAfNRlzuV_b9msft8FzhQ",
    alt: "Braulio Editorial Portrait 2"
  },
  {
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuB_rPxMNyxhEe6LC4WqUnsRfKRvlJRwtlByXkU7FQ0nfWl5w_PgAhcUKWkH2imVBxYcxUcMGVUjuhi6AVJd10e8r57lsIFwCPBv5YoQ9UFCK2_3PSnaZgkkKT7INiIjZbyeVu2e0-N1m81vAlBTZX5b3qAz7NIbWfU6fa74V07rbZFLp-c6a1Wz4iAaO09EcDgGxnzNXYFmxNJ06x75Zl4BtNP0qM63dcPp-7KQ0Hw9y7XUuwbF3M9_Ykk69u7hqYOXnAxb2l47mzg",
    alt: "Braulio Editorial Portrait 3"
  },
  {
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuDZ5rw3ESxrCYuSQSTN1bUHHajGb4hUQoeL4__072bJew6bOaEsBAXNJpGmvSYupIrAwxfQNetWAYbF51tiMRPROt1DeVW5UCFjjoUAkAUnhy8aIzdyCJhytajRk-Kxn3wksUnE7kv9DVffKDde0c79fgpnrGustRkujLa15jIMiUxPhezZjIzaQfUYL-IDJK0HAcof_U6yQUI6yluhOggmBaX20uhJjHpIlblng7XNPdCf6V_w2NvxCv4Kr-xBJgOfOYEJnphNbcE",
    alt: "Braulio Editorial Portrait 4"
  }
