---
import 'swiper/css'
import 'swiper/css/pagination'
import 'swiper/css/free-mode'

import clsx from 'clsx'
import type { SectionProps } from '../../types/Section'
import SectionHeader from '../molecules/SectionHeader.astro'
import EditorialPortrait from '../molecules/EditorialPortrait.astro'
import SocialCard from '../molecules/SocialCard.astro'

import portrait1 from '../../assets/images/gallery/portrait-1.webp'
import portrait2 from '../../assets/images/gallery/portrait-2.webp'
import portrait3 from '../../assets/images/gallery/portrait-3.webp'
import portrait4 from '../../assets/images/gallery/portrait-4.webp'
import portrait5 from '../../assets/images/gallery/portrait-5.webp'
import portrait6 from '../../assets/images/gallery/portrait-6.webp'

interface Platform {
  platform: string
  description: string
  tag: string
  href: string
  accentColor: 'primary' | 'secondary'
}

interface Portrait {
  src: any
  alt: string
}

interface Props extends Partial<SectionProps> {
  class?: string
}

const { id, class: className } = Astro.props

const platforms: Platform[] = [
  {
    platform: 'LinkedIn',
    description:
      'Perspectivas profesionales y análisis detallados sobre el futuro editorial.',
    tag: 'Network',
    href: 'https://www.linkedin.com/in/braulio-filoteo-thrive/',
    accentColor: 'primary',
  },
  {
    platform: 'Instagram',
    description:
      'Inspiración visual, detrás de cámaras y fragmentos de nuestra estética diaria.',
    tag: 'Visual',
    href: 'https://www.instagram.com/brauliofiloteo/',
    accentColor: 'primary',
  },
  {
    platform: 'YouTube',
    description:
      'Contenido audiovisual de larga duración, entrevistas y workshops técnicos.',
    tag: 'Content',
    href: 'https://www.youtube.com/@GRITonespodcast/featured',
    accentColor: 'primary',
  },
]

const portraits: Portrait[] = [
  {
    src: portrait1,
    alt: 'Braulio Editorial Portrait 1',
  },
  {
    src: portrait2,
    alt: 'Braulio Editorial Portrait 2',
  },
  {
    src: portrait3,
    alt: 'Braulio Editorial Portrait 3',
  },
  {
    src: portrait4,
    alt: 'Braulio Editorial Portrait 4',
  },
  {
    src: portrait5,
    alt: 'Braulio Editorial Portrait 5',
  },
  {
    src: portrait6,
    alt: 'Braulio Editorial Portrait 6',
  },
]
---

<section
  id={id}
  class={clsx(
    'container py-24 bg-brand-background w-full px-6 @md:px-12 js-social-section',
    className,
  )}
>
  <div class='max-w-[1440px] mx-auto w-full'>
    <!-- Header Area -->
    <div class='mb-24'>
      <SectionHeader
        label='Connect & Amplify'
        title='Conversaciones que continúan.'
        description='Mantener presencia constante y ampliar conversaciones a través de nuestros ecosistemas digitales.'
        size='editorial'
        titleColor='text-brand-secondary'
        titleClass='text-[2.4rem] @3xl:text-7xl @5xl:text-8xl'
        class='js-social-header js-social-reveal opacity-0'
      />
    </div>

    <!-- Editorial Gallery Slider -->
    <div
      class='mb-24 relative group js-social-gallery js-social-reveal opacity-0'
    >
      <div class='swiper social-swiper'>
        <div
          class='swiper-wrapper pb-4 cursor-grab active:cursor-grabbing select-none'
        >
          {
            portraits.map((portrait, index) => (
              <div class='swiper-slide w-auto! js-social-portrait'>
                <EditorialPortrait
                  src={portrait.src}
                  alt={portrait.alt}
                  variant='minimal'
                  aspect='aspect-[3/4]'
                  class='w-[300px] @md:w-[450px]'
                  data-index={index}
                />
              </div>
            ))
          }
        </div>

        <!-- Gallery Indicators -->
        <div class='swiper-pagination static! mt-8 flex justify-center gap-3'>
        </div>
      </div>
    </div>

    <!-- Platform Engagement Grid -->
    <div class='grid grid-cols-1 @3xl:grid-cols-3 gap-8'>
      {
        platforms.map((platform) => (
          <SocialCard
            {...platform}
            class='js-social-card js-social-reveal opacity-0'
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper'
  import { FreeMode, Pagination, Mousewheel } from 'swiper/modules'
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  function initSocialSwiper() {
    const swiperElement = document.querySelector('.social-swiper')
    if (swiperElement) {
      new Swiper(swiperElement as HTMLElement, {
        modules: [FreeMode, Pagination, Mousewheel],
        slidesPerView: 'auto',
        spaceBetween: 24,
        freeMode: {
          enabled: true,
          momentumBounce: false,
        },
        mousewheel: {
          forceToAxis: true,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          renderBullet: function (index, className) {
            return '<span class="' + className + ' custom-bullet"></span>'
          },
        },
      })
    }
  }

  function initSocialAnimations() {
    const section = document.querySelector('.js-social-section')
    if (!section) return

    const mm = gsap.matchMedia()

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // 1. Unhide elements for GSAP to capture the correct natural state
      gsap.set('.js-social-reveal', {
        autoAlpha: 1,
        force3D: true,
      })

      // 2. Timeline with 'from()' animations
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      })

      tl.from('.js-social-header', {
        autoAlpha: 0,
        y: 40,
        duration: 1.2,
        delay: 0.3,
        ease: 'power4.out',
      })
        .from(
          '.js-social-portrait',
          {
            autoAlpha: 0,
            scale: 0.95,
            duration: 1.0,
            stagger: 0.1,
            ease: 'power3.out',
          },
          '-=0.4',
        )
        .from(
          '.js-social-card',
          {
            autoAlpha: 0,
            y: 30,
            duration: 1.0,
            stagger: 0.15,
            ease: 'power2.out',
          },
          '-=0.5',
        )
    })

    // Fallback for reduced motion: only fade in
    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set('.js-social-reveal', { autoAlpha: 0 })

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      })

      tl.to('.js-social-reveal', {
        autoAlpha: 1,
        duration: 0.8,
        stagger: 0.1,
      })
    })
  }

  // Initialize both
  initSocialSwiper()
  initSocialAnimations()
</script>

<style is:global>
  /* Swiper Pagination Branding Override */
  .social-swiper .swiper-pagination {
    display: flex;
    justify-content: center;
    gap: 0.75rem; /* gap-3 */
  }

  .social-swiper .custom-bullet {
    width: 2rem !important; /* w-8 */
    height: 0.25rem !important; /* h-1 */
    border-radius: 9999px !important; /* rounded-full */
    background: var(--color-brand-outline-variant) !important;
    opacity: 0.3 !important;
    transition: all 0.3s ease;
    cursor: pointer;
    display: block;
  }

  .social-swiper .swiper-pagination-bullet-active {
    background: var(--color-brand-primary) !important;
    opacity: 1 !important;
  }
</style>
