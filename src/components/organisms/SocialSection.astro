---
import clsx from 'clsx';

const socialLinks = [
  { label: 'Instagram', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Spotify', href: '#' },
  { label: 'YouTube', href: '#' },
];
---

<section class="bg-brand-background w-full py-12 px-8 border-t border-brand-surface-bright/20">
  <div class="flex flex-col md:flex-row justify-between items-center gap-6 max-w-screen-2xl mx-auto">
    <span class="text-lg font-bold text-brand-secondary font-brand-display">BRAULIO FILOTEO</span>
    
    <div class="flex gap-8">
      {socialLinks.map((link) => (
        <a 
          href={link.href}
          class="label-md text-brand-text-muted hover:text-brand-primary transition-colors underline decoration-2 underline-offset-4"
        >
          {link.label}
        </a>
      ))}
    </div>
    
    <p class="label-md text-brand-text-muted opacity-80">
      © 2026 BRAULIO FILOTEO. ENDURE TO SHINE.
    </p>
  </div>
</section>
