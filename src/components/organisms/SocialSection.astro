---

<section class="bg-brand-background py-32 px-6 md:px-12">
  <div class="max-w-[1440px] mx-auto">
    <!-- Header Area -->
    <div class="mb-24">
      <SectionHeader 
        label="Connect & Amplify"
        title="Conversaciones que continúan."
        description="Mantener presencia constante y ampliar conversaciones a través de nuestros ecosistemas digitales."
        size="editorial"
        titleColor="text-brand-secondary"
      />
    </div>

    <!-- Editorial Gallery Slider -->
    <div class="mb-24 relative group">
      <div 
        id="social-slider"
        class="flex gap-6 overflow-x-auto hide-scrollbar snap-x pb-4 cursor-grab active:cursor-grabbing select-none"
      >
        {portraits.map((portrait, index) => (
          <EditorialPortrait 
            src={portrait.src}
            alt={portrait.alt}
            variant="minimal"
            aspect="aspect-[3/4]"
            class="min-w-[300px] md:min-w-[450px] snap-center flex-shrink-0"
            data-index={index}
          />
        ))}
      </div>
      
      <!-- Gallery Indicators -->
      <div class="flex justify-center gap-3 mt-8">
        {portraits.map((_, index) => (
          <button
            class="slider-dot w-8 h-1 bg-brand-outline-variant/30 rounded-full transition-all duration-300 hover:bg-brand-primary/50"
            data-index={index}
            aria-label={`Go to slide ${index + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Platform Engagement Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {platforms.map((platform) => (
        <SocialCard {...platform} />
      ))}
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('social-slider');
  const dots = document.querySelectorAll('.slider-dot');
  
  if (slider && dots.length > 0) {
    // Initial active dot
    dots[0].classList.add('!bg-brand-primary');

    // Drag to scroll logic
    let isDown = false;
    let startX;
    let scrollLeft;

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      slider.classList.add('active');
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      isDown = false;
    });

    slider.addEventListener('mouseup', () => {
      isDown = false;
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2; // Scroll speed
      slider.scrollLeft = scrollLeft - walk;
    });

    // Scroll sync with dots
    slider.addEventListener('scroll', () => {
      const scrollPos = slider.scrollLeft;
      const containerWidth = slider.offsetWidth;
      const itemWidth = slider.querySelector('.flex-shrink-0').offsetWidth + 24; // width + gap
      
      const activeIndex = Math.round(scrollPos / itemWidth);
      
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('!bg-brand-primary');
        } else {
          dot.classList.remove('!bg-brand-primary');
        }
      });
    });

    // Click dots to scroll
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index'));
        const itemWidth = slider.querySelector('.flex-shrink-0').offsetWidth + 24;
        slider.scrollTo({
          left: index * itemWidth,
          behavior: 'smooth'
        });
      });
    });
  }
</script>
