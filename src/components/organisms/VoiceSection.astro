---
import clsx from 'clsx';
import SectionWrapper from './SectionWrapper.astro';
import TransformationCard from '../molecules/TransformationCard.astro';
import type { SectionProps } from '../../types/Section';

interface Props extends Partial<SectionProps> {}

const { id } = Astro.props;

const matrixItems = [
  {
    title: "claridad de propósito",
    icon: "target"
  },
  {
    title: "narrativa personal",
    icon: "auto_stories"
  },
  {
    title: "consistencia",
    icon: "sync"
  },
  {
    title: "conversaciones profundas",
    icon: "forum"
  }
];
---

<SectionWrapper id={id} variant="lowest" fullHeight={false} class="pt-20 @3xl:pt-32 pb-0 js-voice-section">
  <div class="editorial-grid gap-y-12 @3xl:gap-y-24">
    <!-- Asymmetric Text Blocks -->
    <div class="col-span-12 grid grid-cols-12 gap-y-12 @3xl:gap-y-16">
      <!-- Headline Block: Responsive spans -->
      <div class="col-span-12 @3xl:col-span-10 @5xl:col-span-9 js-voice-reveal opacity-0">
        <p class="label-md text-brand-secondary tracking-[0.2em] mb-4">
          Metodología Noir
        </p>
        <h2 class="font-brand-display text-4xl @3xl:text-6xl @5xl:text-8xl font-black tracking-tighter leading-[0.9] text-brand-text-high uppercase break-words">
          Tu voz puede <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary to-brand-primary-light">convertirse</span> en una plataforma.
        </h2>
      </div>

      <!-- Description Block: Responsive placement -->
      <div class="col-span-12 @3xl:col-start-2 @3xl:col-span-11 @5xl:col-start-6 @5xl:col-span-6 border-l-4 border-brand-primary pl-6 @md:pl-8 py-4 js-voice-reveal opacity-0">
        <p class="text-xl @md:text-2xl font-light text-brand-text-muted leading-relaxed">
          Hoy la marca personal no se construye con frases motivacionales. Se construye con la profundidad de las ideas y la radicalidad de la ejecución.
        </p>
      </div>
    </div>

    <!-- Transformation Matrix Grid -->
    <div class="col-span-12 grid grid-cols-1 @md:grid-cols-2 @5xl:grid-cols-4 gap-6">
      {matrixItems.map((item) => (
        <TransformationCard 
          {...item} 
          class="js-matrix-card js-voice-reveal opacity-0"
        />
      ))}
    </div>
  </div>
</SectionWrapper>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Register plugin locally
  gsap.registerPlugin(ScrollTrigger);

  function initVoiceAnimations() {
    const section = document.querySelector('.js-voice-section');
    if (!section) return;

    const reveals = section.querySelectorAll('.js-voice-reveal');
    const matrixCards = section.querySelectorAll('.js-matrix-card');
    
    // Specifically target the text blocks which are the first two elements with .js-voice-reveal
    const headline = reveals[0];
    const description = reveals[1];

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Unhide for GSAP to capture natural state
      gsap.set(reveals, { autoAlpha: 1 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          toggleActions: "play none none none"
        }
      });

      // 1. Headline reveal
      if (headline) {
        tl.from(headline, {
          y: 40,
          autoAlpha: 0,
          duration: 1.2,
          ease: "power4.out"
        });
      }

      // 2. Description reveal
      if (description) {
        tl.from(description, {
          y: 20,
          autoAlpha: 0,
          duration: 1.0,
          ease: "power3.out"
        }, "-=0.8");
      }

      // 3. Matrix Cards Reveal (Wave)
      if (matrixCards.length > 0) {
        tl.from(matrixCards, {
          y: 30,
          autoAlpha: 0,
          duration: 1.0,
          stagger: 0.1,
          ease: "power3.out"
        }, "-=0.6");
      }
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.to(reveals, {
        autoAlpha: 1,
        duration: 0.8,
        stagger: 0.1,
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          toggleActions: "play none none none"
        }
      });
    });
  }

  initVoiceAnimations();
</script>
