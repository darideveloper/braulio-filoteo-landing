---
import SectionWrapper from './SectionWrapper.astro';
import type { SectionProps } from '../../types/Section';
import SectionHeader from '../molecules/SectionHeader.astro';
import BrandButton from '../atoms/BrandButton.astro';
import MaterialIcon from '../atoms/MaterialIcon.astro';
import clsx from 'clsx';

interface Props extends Partial<SectionProps> {
  class?: string;
}

const { id, class: className } = Astro.props;
---

<SectionWrapper 
  id={id}
  variant="lowest" 
  class={clsx("min-h-screen flex items-center justify-center", className)}
>
  <!-- Background Watermark -->
  <div slot="background" class="absolute inset-0 flex items-center justify-center overflow-hidden pointer-events-none">
    <span class="text-watermark select-none" aria-hidden="true">GRIT</span>
  </div>

  <div class="max-w-4xl mx-auto">
    <SectionHeader 
      label=""
      align="center"
      size="editorial"
      class="mb-12"
    >
      <Fragment slot="title">
        <span class="display-2xl block text-brand-text-high !leading-tight">
          TU HISTORIA <span class="text-brand-secondary italic decoration-editorial">MERECE</span><br/>SER CONTADA.
        </span>
      </Fragment>

      <Fragment slot="description">
        <p class="text-xl @md:text-2xl font-medium max-w-2xl mx-auto leading-relaxed text-brand-text-muted">
          Si llevas años acumulando experiencia, quizá ya es momento de <span class="text-brand-text-high border-b-2 border-brand-secondary">convertir tu voz</span> en una <span class="text-brand-text-high border-b-2 border-brand-secondary">plataforma</span>.
        </p>
      </Fragment>

      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-8">
        <BrandButton 
          variant="primary-gradient" 
          href="#"
          class="w-full sm:w-auto"
        >
          Crea tu podcast
        </BrandButton>

        <div class="flex items-center gap-4 text-sm font-bold tracking-widest uppercase text-brand-text-muted group">
          <MaterialIcon name="mail" class="text-brand-primary" />
          <span class="label-md lowercase">hola@brauliofiloteo.com</span>
        </div>
      </div>
    </SectionHeader>
  </div>
</SectionWrapper>
