---
import '../styles/global.css'
import Sidebar from '../components/organisms/Sidebar.astro'
import Header from '../components/organisms/Header.astro'
import Footer from '../components/organisms/Footer.astro'
import Loader from '../components/organisms/Loader.astro'
import BaseSEO from '../components/organisms/BaseSEO.astro'

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props
---

<!doctype html>
<html
  lang='es'
  class='bg-brand-background no-js'
>
  <head>
    <BaseSEO {title} {description} {ogImage} />
    <script is:inline>
      document.documentElement.classList.remove('no-js')
      document.documentElement.classList.add('js')
    </script>

    <link
      href='https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,300..900;1,300..900&family=Inter:ital,wght@0,100..900;1,100..900&display=swap'
      rel='stylesheet'
    />
    <link
      href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap'
      rel='stylesheet'
    />

    <link
      rel='sitemap'
      href='/sitemap-index.xml'
    />
    <script>
      import '../scripts/gsap-init'
    </script>
  </head>
  <body class='bg-brand-background text-brand-text-high antialiased'>
    <Loader />
    <div class='min-h-screen flex flex-col'>
      <Sidebar />
      <Header />

      <main class='@container min-h-screen xl:ml-[250px]'>
        <slot />
        <Footer />
      </main>
    </div>
  </body>
</html>
