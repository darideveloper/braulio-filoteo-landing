---
import '../styles/global.css'
import Sidebar from '../components/organisms/Sidebar.astro';
import Header from '../components/organisms/Header.astro';

interface Props {
  title?: string;
}

const { title = "Braulio Filoteo / Creative Portfolio" } = Astro.props;
---

<!doctype html>
<html lang='en' class="bg-black">
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width'
    />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/favicon.svg'
    />
    <link
      rel='icon'
      href='/favicon.ico'
    />
    <meta
      name='generator'
      content={Astro.generator}
    />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,900;1,900&family=Inter:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

    <link
      rel='sitemap'
      href='/sitemap-index.xml'
    />
  </head>
  <body class="bg-brand-background text-brand-text-high antialiased">
    <div class="flex flex-col lg:flex-row min-h-screen">
      <Sidebar />
      <Header />
      
      <main class="flex-grow min-h-screen lg:ml-[280px] pt-20 lg:pt-0">
        <slot />
      </main>
    </div>
  </body>
</html>
