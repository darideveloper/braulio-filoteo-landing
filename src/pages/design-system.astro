---
import Layout from '../layouts/Layout.astro';
import BrandButton from '../components/atoms/BrandButton.astro';
import ColorSwatch from '../components/atoms/ColorSwatch.astro';
import Badge from '../components/atoms/Badge.astro';
import StatItem from '../components/atoms/StatItem.astro';
import AboutIcon from '../components/atoms/AboutIcon.astro';
import AboutCard from '../components/molecules/AboutCard.astro';
import QuoteBlock from '../components/molecules/QuoteBlock.astro';
import EditorialPortrait from '../components/molecules/EditorialPortrait.astro';
import Navigation from '../components/molecules/Navigation.astro';
import Header from '../components/organisms/Header.astro';
import clsx from 'clsx';

const colors = [
  { label: 'Background', color: '#0E0E0E', role: 'surface_container_lowest: The deepest foundation.' },
  { label: 'Surface', color: '#1C1B1B', role: 'surface_container_low: The standard content stage.' },
  { label: 'Surface Bright', color: '#393939', role: 'surface_bright: Elevated interactive elements.' },
  { label: 'Primary (Action)', color: '#9B30FF', role: 'primary_container: High-intent interactions (Purple).' },
  { label: 'Primary Light', color: '#DCB8FF', role: 'primary: Start color for CTA gradients.' },
  { label: 'Secondary (Heading)', color: '#FE6500', role: 'secondary_container: Editorial Orange for headlines.' },
  { label: 'Text High', color: '#E5E2E1', role: 'on_background: Maximum readability off-white.' },
  { label: 'Text Muted', color: '#CFC2D8', role: 'on_surface_variant: Secondary descriptions.' },
];

const typography = [
  { label: 'Display-LG', class: 'display-lg', text: 'NEON NOIR.' },
  { label: 'Headline-MD', class: 'headline-md text-brand-secondary', text: 'Section Title Headline' },
  { label: 'Label-MD', class: 'label-md text-brand-text-muted', text: 'Technical Metadata / Overline' },
  { label: 'Body-LG', class: 'body-lg', text: 'The "Neon Noir Editorial" style favors dramatic whitespace, intentional asymmetry, and the visceral tension between deep shadows and vibrant accents.' },
  { label: 'Body Bold', class: 'body-lg font-bold', text: 'Luxury tracking and editorial breaks.' },
];
---

<Layout title="Design System / Neon Noir">
  <main class="container py-[8.5rem] space-y-32">
    <section>
      <h1 class="display-lg mb-12 text-brand-secondary">Design System</h1>
      <p class="body-lg text-brand-text-muted max-w-2xl">
        A visual documentation of the "Neon Noir Editorial" branding, tokens, and utility classes.
      </p>
    </section>

    <!-- Atoms: Colors -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Atoms</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">Color Palette</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {colors.map((c) => (
          <ColorSwatch {...c} />
        ))}
      </div>
    </section>

    <!-- Atoms: Typography -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Atoms</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">Typography</h2>
      </div>
      <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
        {typography.map((type) => (
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-baseline">
            <p class="text-xs text-brand-text-muted font-mono">{type.label}</p>
            <div class={clsx("md:col-span-3", type.class)}>
              {type.text}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Atoms: New Components -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Atoms</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">New Components</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-brand-surface p-12 rounded-[0.5rem]">
        <div class="space-y-4">
          <p class="text-xs text-brand-text-muted font-mono mb-4">Badge</p>
          <div class="flex gap-4">
            <Badge>Host</Badge>
            <Badge>Entrepreneur</Badge>
          </div>
        </div>
        <div class="space-y-4">
          <p class="text-xs text-brand-text-muted font-mono mb-4">StatItem</p>
          <div class="flex gap-8">
            <StatItem value="100+" label="Episodes" variant="primary" />
            <StatItem value="30+" label="Projects" variant="secondary" />
          </div>
        </div>
      </div>
    </section>

    <!-- Atoms: Buttons -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Atoms</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">BrandButton</h2>
      </div>
      <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono">Primary (Gradient + Icon)</p>
            <BrandButton variant="primary" icon="play_circle">Primary Action</BrandButton>
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono">Secondary (Solid Orange)</p>
            <BrandButton variant="secondary">Secondary</BrandButton>
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono">Outline (Glass + Icon)</p>
            <BrandButton variant="outline" icon="mic">Outline Action</BrandButton>
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono">Ghost</p>
            <BrandButton variant="ghost">Ghost Action</BrandButton>
          </div>
        </div>
      </div>
    </section>

    <!-- Molecules: EditorialPortrait -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Molecules</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">EditorialPortrait</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 bg-brand-surface p-12 rounded-[0.5rem]">
        <div class="space-y-6">
          <p class="text-xs text-brand-text-muted font-mono">Primary Accent (Default)</p>
          <div class="max-w-xs">
            <EditorialPortrait 
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1000&auto=format&fit=crop"
              alt="Portrait Primary"
              floatingLabel="EST. 2024"
              verticalText="PRIMARY ACCENT"
              accent="primary"
            />
          </div>
        </div>
        <div class="space-y-6">
          <p class="text-xs text-brand-text-muted font-mono">Secondary Accent (Orange Frame)</p>
          <div class="max-w-xs">
            <EditorialPortrait 
              src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1000&auto=format&fit=crop"
              alt="Portrait Secondary"
              floatingLabel="BIO"
              verticalText="SECONDARY ACCENT"
              accent="secondary"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Molecules: Navigation -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Molecules</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">Navigation</h2>
      </div>
      <div class="bg-brand-surface p-12 rounded-[0.5rem] max-w-sm">
        <Navigation />
      </div>
    </section>

    <!-- Molecules: About Components -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">About</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">About Components</h2>
      </div>
      <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">AboutCard</p>
            <AboutCard 
              number="01"
              title="Coleccionar historias"
              description="Excavar hasta encontrar el núcleo de la experiencia humana, el fracaso y la resiliencia."
            />
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">QuoteBlock</p>
            <QuoteBlock 
              text="La inspiración está bien, pero la acción es mejor."
              author="Manifiesto GRITones"
            />
          </div>
        </div>
        <div class="space-y-4">
          <p class="text-xs text-brand-text-muted font-mono mb-4">AboutIcon Variants</p>
          <div class="flex gap-8">
            <AboutIcon icon="fitness_center" variant="primary" class="!text-4xl" />
            <AboutIcon icon="menu_book" variant="secondary" class="!text-4xl" />
            <AboutIcon icon="verified" variant="muted" class="!text-4xl" />
            <AboutIcon icon="arrow_forward" variant="white" class="!text-4xl" />
          </div>
        </div>
      </div>
    </section>

    <!-- Utilities -->
    <section class="space-y-12">
      <div class="space-y-4">
        <span class="label-md text-brand-primary">Utilities</span>
        <h2 class="headline-md uppercase tracking-widest text-brand-secondary">Signature Effects</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-4">
          <p class="text-xs text-brand-text-muted font-mono mb-4">.shadow-neon-purple</p>
          <div class="h-64 w-full rounded-[0.5rem] bg-brand-surface relative overflow-hidden shadow-neon-purple">
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-brand-text-muted text-sm">Neon Glow (Box Shadow)</span>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <p class="text-xs text-brand-text-muted font-mono mb-4">.img-editorial (Hover to test)</p>
          <div class="relative group aspect-video rounded-[0.5rem] overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=1000&auto=format&fit=crop" 
              alt="Test Image"
              class="w-full h-full object-cover img-editorial"
            />
            <div class="absolute bottom-4 left-4">
               <span class="bg-brand-gradient text-white label-md px-3 py-1 rounded-[0.25rem]">EST. 2024</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="pt-20 text-center">
       <p class="label-md text-brand-text-muted tracking-[0.5em]">Neon Noir / 2026</p>
    </footer>
  </main>
</Layout>
