---
import Layout from '../layouts/Layout.astro';
import BrandButton from '../components/atoms/BrandButton.astro';
import ColorSwatch from '../components/atoms/ColorSwatch.astro';
import Badge from '../components/atoms/Badge.astro';
import StatItem from '../components/atoms/StatItem.astro';
import AboutIcon from '../components/atoms/AboutIcon.astro';
import MaterialIcon from '../components/atoms/MaterialIcon.astro';
import SpotifyEmbed from '../components/atoms/SpotifyEmbed.astro';
import AboutCard from '../components/molecules/AboutCard.astro';
import QuoteBlock from '../components/molecules/QuoteBlock.astro';
import EditorialPortrait from '../components/molecules/EditorialPortrait.astro';
import Navigation from '../components/molecules/Navigation.astro';
import SectionHeader from '../components/molecules/SectionHeader.astro';
import EditorialHeadline from '../components/molecules/EditorialHeadline.astro';
import PodcastCTA from '../components/molecules/PodcastCTA.astro';
import SideBorderQuote from '../components/molecules/SideBorderQuote.astro';
import MatrixCard from '../components/molecules/MatrixCard.astro';
import FeatureCTA from '../components/molecules/FeatureCTA.astro';
import HeroEditorial from '../components/organisms/HeroEditorial.astro';
import Footer from '../components/organisms/Footer.astro';
import clsx from 'clsx';

if (import.meta.env.PROD) {
  return Astro.redirect('/404');
}

const colors = [
  { label: "Background", color: "#0E0E0E", role: "Deep Foundation" },
  { label: "Surface", color: "#131313", role: "Standard Content Stage" },
  { label: "Surface Low", color: "#1C1B1B", role: "Sunken Elements" },
  { label: "Surface Container", color: "#201F1F", role: "Standard Container" },
  { label: "Surface Bright", color: "#393939", role: "Elevated Elements" },
  { label: "Primary (Action)", color: "#9B30FF", role: "High-intent Interactions" },
  { label: "Primary Light", color: "#DCB8FF", role: "CTA Gradients" },
  { label: "Secondary (Heading)", color: "#FE6500", role: "Editorial Headlines" },
  { label: "Text High", color: "#E5E2E1", role: "Readability White" },
  { label: "Text Muted", color: "#CFC2D8", role: "Secondary Descriptions" }
];

const typography = [
  { label: "Display-LG", class: "display-lg", text: "NEON NOIR." },
  { label: "Headline-MD", class: "headline-md text-brand-secondary", text: "Section Title Headline" },
  { label: "Label-MD", class: "label-md text-brand-text-muted", text: "Technical Metadata" },
  { label: "Body-LG", class: "body-lg", text: "The Neon Noir Editorial style favors dramatic whitespace and intentional asymmetry." },
  { label: "Body Bold", class: "body-lg font-bold", text: "Luxury tracking and editorial breaks." }
];
---

<Layout title="Design System / Neon Noir">
  <main class="container py-[8.5rem] space-y-48">
    <SectionHeader 
      label="Brand Documentation"
      title="Design System"
      level={1}
      titleColor="text-brand-secondary"
      description="A visual documentation of the Neon Noir Editorial branding, tokens, and component library."
    />

    <!-- 1. Foundations -->
    <div class="space-y-24">
      <div class="border-b border-brand-surface-bright/20 pb-8">
        <h2 class="display-lg text-brand-text-high opacity-20 uppercase tracking-widest">01 / Foundations</h2>
      </div>

      <!-- Colors -->
      <section class="space-y-12">
        <SectionHeader 
          label="Design Tokens"
          title="Color Palette"
          titleColor="text-brand-secondary"
        />
        <div class="grid grid-cols-1 @sm:grid-cols-2 @lg:grid-cols-4 gap-8">
          {colors.map((c) => (
            <ColorSwatch {...c} />
          ))}
        </div>
      </section>

      <!-- Typography -->
      <section class="space-y-12">
        <SectionHeader 
          label="Design Tokens"
          title="Typography"
          titleColor="text-brand-secondary"
        />
        <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
          {typography.map((type) => (
            <div class="grid grid-cols-1 @md:grid-cols-4 gap-4 items-baseline">
              <p class="text-xs text-brand-text-muted font-mono">{type.label}</p>
              <div class={clsx("@md:col-span-3", type.class)}>
                {type.text}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- 2. Atoms -->
    <div class="space-y-24">
      <div class="border-b border-brand-surface-bright/20 pb-8">
        <h2 class="display-lg text-brand-text-high opacity-20 uppercase tracking-widest">02 / Atoms</h2>
      </div>

      <!-- Buttons -->
      <section class="space-y-12">
        <SectionHeader 
          label="Interactive"
          title="BrandButton"
          titleColor="text-brand-secondary"
        />
        <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
          <div class="grid grid-cols-1 @md:grid-cols-2 @lg:grid-cols-4 gap-8">
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Primary (with Icon)</p>
              <BrandButton variant="primary" icon="play_circle">Primary Action</BrandButton>
            </div>
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Primary (No Icon)</p>
              <BrandButton variant="primary">Primary Only</BrandButton>
            </div>
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Secondary (Solid Orange)</p>
              <BrandButton variant="secondary">Secondary</BrandButton>
            </div>
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Outline (Glass + Icon)</p>
              <BrandButton variant="outline" icon="mic">Outline Action</BrandButton>
            </div>
          </div>
          <div class="grid grid-cols-1 @md:grid-cols-2 @lg:grid-cols-4 gap-8">
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Ghost</p>
              <BrandButton variant="ghost">Ghost Action</BrandButton>
            </div>
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Disabled (Primary)</p>
              <BrandButton variant="primary" disabled>Locked Button</BrandButton>
            </div>
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Disabled (Outline)</p>
              <BrandButton variant="outline" disabled icon="lock">Locked Outline</BrandButton>
            </div>
          </div>
          <div class="grid grid-cols-1 @md:grid-cols-2 @lg:grid-cols-4 gap-8 border-t border-brand-surface-bright/10 pt-8">
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Circular (Primary)</p>
              <BrandButton variant="primary" icon="add" circular />
            </div>
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono">Circular (Secondary)</p>
              <BrandButton variant="secondary" icon="mic" circular />
            </div>
          </div>
        </div>
      </section>

      <!-- Indicators & Media -->
      <section class="space-y-12">
        <SectionHeader 
          label="Primitive UI"
          title="Indicators & Media"
          titleColor="text-brand-secondary"
        />
        <div class="grid grid-cols-1 @md:grid-cols-2 gap-12 bg-brand-surface p-12 rounded-[0.5rem]">
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">Badge</p>
            <div class="flex gap-4">
              <Badge>Host</Badge>
              <Badge class="!bg-brand-secondary/20 !text-brand-secondary !border-brand-secondary/30">Entrepreneur</Badge>
            </div>
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">StatItem</p>
            <div class="flex gap-8">
              <StatItem value="100+" label="Episodes" variant="primary" />
              <StatItem value="2.5k" label="Subscribers" variant="secondary" />
            </div>
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">MaterialIcon Scaling</p>
            <div class="flex flex-wrap gap-8 items-center">
              <MaterialIcon name="mic" size="text-2xl" class="text-brand-secondary" />
              <MaterialIcon name="mic" size="text-4xl" class="text-brand-secondary" />
              <MaterialIcon name="mic" size="text-6xl" class="text-brand-secondary" />
              <MaterialIcon name="mic" size="text-8xl" class="text-brand-secondary" />
            </div>
          </div>
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">SpotifyEmbed</p>
            <div class="max-w-md w-full">
              <SpotifyEmbed 
                url="https://open.spotify.com/show/2v8G6l6f6j9S9Z9O9N9I9" 
                height={152} 
                title="Mini Player"
              />
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- 3. Molecules -->
    <div class="space-y-24">
      <div class="border-b border-brand-surface-bright/20 pb-8">
        <h2 class="display-lg text-brand-text-high opacity-20 uppercase tracking-widest">03 / Molecules</h2>
      </div>

      <!-- Editorial Elements -->
      <section class="space-y-12">
        <SectionHeader 
          label="Visual Language"
          title="Editorial Elements"
          titleColor="text-brand-secondary"
        />
        <div class="bg-brand-surface p-12 rounded-[0.5rem] space-y-16">
          <div class="grid grid-cols-1 @lg:grid-cols-3 gap-16">
            <div class="space-y-6">
              <p class="text-xs text-brand-text-muted font-mono">Portrait: Primary Accent</p>
              <div class="max-w-[280px]">
                <EditorialPortrait 
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1000&auto=format&fit=crop"
                  alt="Portrait Primary"
                  floatingLabel="EST. 2024"
                  verticalText="PRIMARY ACCENT"
                  accent="primary"
                />
              </div>
            </div>
            <div class="space-y-6">
              <p class="text-xs text-brand-text-muted font-mono">Portrait: Secondary Accent</p>
              <div class="max-w-[280px]">
                <EditorialPortrait 
                  src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1000&auto=format&fit=crop"
                  alt="Portrait Secondary"
                  floatingLabel="BIO"
                  verticalText="SECONDARY ACCENT"
                  accent="secondary"
                />
              </div>
            </div>
            <div class="space-y-6">
              <p class="text-xs text-brand-text-muted font-mono">Headline & Section Header</p>
              <div class="space-y-8">
                <EditorialHeadline>DISEÑO CRÍTICO.</EditorialHeadline>
                <SectionHeader 
                  label="Enfoque"
                  title="Nueva Perspectiva"
                  level={2}
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Content Blocks -->
      <section class="space-y-12">
        <SectionHeader 
          label="Narrative UI"
          title="Content Blocks"
          titleColor="text-brand-secondary"
        />
        <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
          <div class="grid grid-cols-1 @lg:grid-cols-3 gap-8">
            <div class="space-y-4">
              <p class="text-xs text-brand-text-muted font-mono mb-4">AboutCard (Grid Pattern)</p>
              <div class="space-y-4">
                <AboutCard number="01" title="Estrategia" description="Definición del núcleo narrativo." />
                <AboutCard number="02" title="Ejecución" description="Producción de alto impacto." />
              </div>
            </div>
            <div class="@lg:col-span-2 space-y-4">
              <p class="text-xs text-brand-text-muted font-mono mb-4">QuoteBlock & SideBorderQuote</p>
              <div class="space-y-8">
                <QuoteBlock 
                  text="La inspiración está bien, pero la acción es mejor. El grit es el motor de la transformation real."
                  author="Manifiesto GRITones"
                />
                <SideBorderQuote class="text-xl text-brand-text-high max-w-xl">
                  "El carácter no se construye en la comodidad, sino en la tensión entre lo que somos y lo que aspiramos ser."
                </SideBorderQuote>
              </div>
            </div>
          </div>
          <div class="space-y-8 border-t border-brand-surface-bright/20 pt-12">
            <p class="text-xs text-brand-text-muted font-mono">PodcastCTA (Complex Molecule)</p>
            <PodcastCTA 
              title="¿Tienes una historia que merece ser escuchada?"
              description="Llevamos tu mensaje al siguiente nivel con Podcast Express."
              href="#"
            />
          </div>
        </div>
      </section>

      <!-- Navigation -->
      <section class="space-y-12">
        <SectionHeader 
          label="Interface"
          title="Navigation"
          titleColor="text-brand-secondary"
        />
        <div class="bg-brand-surface p-12 rounded-[0.5rem] max-w-sm">
          <Navigation />
          </div>
          </div>
          </section>

          <!-- Voice Editorial Molecules -->
          <section class="space-y-12">
          <SectionHeader 
          label="Voice Style"
          title="Editorial Molecules"
          titleColor="text-brand-secondary"
          />
          <div class="space-y-12 bg-brand-surface p-12 rounded-[0.5rem]">
          <div class="grid grid-cols-1 @md:grid-cols-2 @lg:grid-cols-4 gap-8">
           <MatrixCard title="narrativa personal" icon="auto_stories" />
           <MatrixCard title="consistencia" icon="sync" />
           <MatrixCard title="conversaciones" icon="forum" />
           <MatrixCard title="claridad" icon="target" />
          </div>
          <div class="border-t border-brand-surface-bright/20 pt-12">
          <FeatureCTA label="Test Label" ctaText="Test CTA" icon="mic">
            Testing the <span class="decoration-editorial">editorial</span> CTA variant.
          </FeatureCTA>
          </div>
          </div>
          </section>
          </div>

          <!-- 4. Organisms -->
          <div class="space-y-24">
          <div class="border-b border-brand-surface-bright/20 pb-8">
            <h2 class="display-lg text-brand-text-high opacity-20 uppercase tracking-widest">04 / Organisms</h2>
          </div>

          <section class="space-y-12">
            <SectionHeader 
              label="Layout"
              title="HeroEditorial"
              titleColor="text-brand-secondary"
            />
            <div class="border border-brand-surface-bright/20 rounded-[0.5rem] overflow-hidden scale-90 origin-top">
              <HeroEditorial 
                badge="Metodología Noir"
                title="Tu voz puede convertirse en una plataforma."
                description="Hoy la marca personal no se construye con frases motivacionales. Se construye con la profundidad de las ideas y la radicalidad de la ejecución."
              />
            </div>
          </section>

          <section class="space-y-12">
            <SectionHeader 
              label="Layout"
              title="Footer"
              titleColor="text-brand-secondary"
            />
            <div class="border border-brand-surface-bright/20 rounded-[0.5rem] overflow-hidden">
               <Footer />
            </div>
          </section>
          </div>

          <!-- 5. Utilities -->
          <div class="space-y-24">
          <div class="border-b border-brand-surface-bright/20 pb-8">
            <h2 class="display-lg text-brand-text-high opacity-20 uppercase tracking-widest">05 / Utilities</h2>
          </div>

      <section class="space-y-12">
        <SectionHeader 
          label="Signature"
          title="Effects & Behaviors"
          titleColor="text-brand-secondary"
        />
        <div class="grid grid-cols-1 @md:grid-cols-2 gap-12">
          <div class="space-y-4">
            <p class="text-xs text-brand-text-muted font-mono mb-4">.shadow-neon-purple / .neon-glow</p>
            <div class="h-64 w-full rounded-[0.5rem] bg-brand-surface relative overflow-hidden shadow-neon-purple">
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-brand-text-muted text-sm">Neon Glow (Box Shadow)</span>
              </div>
            </div>
          </div>
          <div class="space-y-4">
             <p class="text-xs text-brand-text-muted font-mono mb-4">.editorial-grid (12 cols)</p>
             <div class="editorial-grid gap-4 bg-brand-surface p-4 rounded-[0.5rem]">
               {Array.from({ length: 12 }).map((_, i) => (
                 <div class="h-12 bg-brand-primary/20 border border-brand-primary/30 flex items-center justify-center text-[10px] font-mono text-brand-primary">
                   {i + 1}
                 </div>
               ))}
             </div>
          </div>
          <div class="space-y-4 @md:col-span-2">
            <p class="text-xs text-brand-text-muted font-mono mb-4">.img-editorial (Hover to test)</p>
            <div class="relative group aspect-video rounded-[0.5rem] overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=1000&auto=format&fit=crop" 
                alt="Test Image"
                class="w-full h-full object-cover img-editorial"
              />
              <div class="absolute bottom-4 left-4">
                 <span class="bg-brand-gradient text-white label-md px-3 py-1 rounded-[0.25rem]">EST. 2024</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <footer class="pt-20 text-center border-t border-brand-surface-bright/20">
       <p class="label-md text-brand-text-muted tracking-[0.5em]">Neon Noir / 2026</p>
    </footer>
  </main>
</Layout>
