---
import Hero from '../components/organisms/Hero.astro'
import AboutSection from '../components/organisms/AboutSection.astro'
import PodcastSection from '../components/organisms/PodcastSection.astro'
import NewsletterSection from '../components/organisms/NewsletterSection.astro'
import Layout from '../layouts/Layout.astro'
import CtaSection from '../components/organisms/CtaSection.astro'
import SocialSection from '../components/organisms/SocialSection.astro'
import EditorialHeadline from '../components/molecules/EditorialHeadline.astro'
import BrandButton from '../components/atoms/BrandButton.astro'
import HeroEditorial from '../components/organisms/HeroEditorial.astro'
import MatrixCard from '../components/molecules/MatrixCard.astro'
import FeatureCTA from '../components/molecules/FeatureCTA.astro'
import SectionWrapper from '../components/organisms/SectionWrapper.astro'
---

<Layout>
  <Hero />
  <AboutSection />
  <PodcastSection />
  <CtaSection
    watermark='GRIT'
    showContact={true}
  >
    <EditorialHeadline
      slot='headline'
      class='leading-[1.2] text-white'
    >
      LO QUE
      <span class='text-brand-secondary italic decoration-editorial'>
        CUENTAS
      </span>,<br />CUENTA.
    </EditorialHeadline>
    <div slot='description' class="mb-12">
      <p>
        Las historias construyen <span
          class='text-white border-b-2 border-brand-primary'>reputación</span
        >. <br />
        La reputation construye <span
          class='text-white border-b-2 border-brand-primary'>oportunidades</span
        >.
      </p>
    </div>
    <BrandButton
      slot='cta'
      href='#'
      variant='secondary'
    >
      Empieza tu Viaje
    </BrandButton>
  </CtaSection>
  <NewsletterSection />
  <SocialSection />

  <!-- Voice Editorial Sections -->
  <HeroEditorial 
    badge="Metodología Noir"
    title="Tu voz puede convertirse en una plataforma."
    description="Hoy la marca personal no se construye con frases motivacionales. Se construye con la profundidad de las ideas y la radicalidad de la ejecución."
  >
    <span slot="title">
      Tu voz puede <span class="text-brand-gradient italic">convertirse</span> en una plataforma.
    </span>
  </HeroEditorial>

  <SectionWrapper variant="lowest" class="py-24">
    <div class="grid grid-cols-1 @sm:grid-cols-2 @lg:grid-cols-4 gap-6">
      <MatrixCard title="claridad de propósito" icon="target" />
      <MatrixCard title="narrativa personal" icon="auto_stories" />
      <MatrixCard title="consistencia" icon="sync" />
      <MatrixCard title="conversaciones profundas" icon="forum" />
    </div>
  </SectionWrapper>

  <SectionWrapper variant="lowest" class="py-24 relative overflow-hidden">
    <FeatureCTA 
      label="El Vehículo" 
      ctaText="Inicia tu Proyecto" 
      icon="mic"
      watermark="VOICE"
      watermarkAlign="right"
      watermarkSize="20rem"
      watermarkOpacity={0.08}
    >
      El vehículo más poderoso para hacerlo es un <span class="decoration-editorial">podcast</span>.
    </FeatureCTA>
  </SectionWrapper>
</Layout>
